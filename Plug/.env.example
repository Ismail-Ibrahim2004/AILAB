# ============================================================
# Voice AI Smart Relay Controller — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ============================================================

# ── Runtime environment ───────────────────────────────────
# Options: development | production | testing
ENVIRONMENT=development

# ── API Keys (REQUIRED) ───────────────────────────────────
# HuggingFace token for Whisper large-v3 inference
HF_TOKEN=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

# Google Gemini API key
GEMINI_API_KEY=AIzaSyD3hUABhkKLacfDyifS6PXvLgA5KHskPlk

# ── Whisper configuration ─────────────────────────────────
WHISPER_MODEL_URL=https://router.huggingface.co/hf-inference/models/openai/whisper-large-v3
WHISPER_TIMEOUT_SECONDS=30

# ── Audio validation ──────────────────────────────────────
# Maximum upload size in bytes (default: 10 MB)
AUDIO_MAX_SIZE_BYTES=10485760

# ── AI / Gemini ───────────────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash
INTENT_CONFIDENCE_THRESHOLD=0.6

# ── Relay / GPIO (Raspberry Pi) ───────────────────────────
RELAY_COUNT=8
# BCM GPIO pin numbers for relay indices 0-7 (comma-separated)
GPIO_PINS_BCM=[17,18,27,22,23,24,25,4]
GPIO_ACTIVE_LOW=true

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
